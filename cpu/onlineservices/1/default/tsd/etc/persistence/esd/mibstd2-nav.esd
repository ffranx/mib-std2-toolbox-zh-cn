screen Navi Customization

keyValue
    value   String sys 0x00000000 0
    label   "补丁: 允许用其它品牌地图 SD"
	poll 	0

script
	value 	sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/patch_nav.sh"
	label 	"补丁: 导航配置"

script
	value 	sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/restore_nav.sh"
	label 	"从备份恢复导航配置"

keyValue
    value   String sys 0x00000000 0
	label	""
	poll    0

keyValue
    value   String sys 0x00000000 0
    label   "补丁: 忽略手机导航激活状态"
	poll 	0
	
keyValue
    value   String sys 0x00000000 0
    label   "CarPlay/AA 可与车机导航并行"
	poll 	0

keyValue
    value   String sys 0x00000000 0
    label   "基于 andrewleech 等人的 MHI2 补丁"
	poll 	0

script
	value 	sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/activate_navignore.sh"
	label 	"开启双导航"

script
	value 	sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/deactivate_navignore.sh"
	label 	"关闭双导航"

keyValue
    value   String sys 0x00000000 0
	label	""
	poll    0

keyValue
    value   String sys 0x00000000 0
    label   "仪表显示 Android Auto 导航"
	poll 	0

keyValue
    value   String sys 0x00000000 0
    label   "需 jar + libgal (见下说明)"
	poll 	0

script
	value 	sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/activate_aatokombi.sh"
	label 	"开启 AAtoKombi"

script
	value 	sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/deactivate_aatokombi.sh"
	label 	"关闭 AAtoKombi"

script
	value 	sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/dump_aatokombi_sources.sh"
	label 	"导出原厂 libgal 与 HMI"

keyValue
    value   String sys 0x00000000 0
	label	""
	poll    0

keyValue
    value   String sys 0x00000000 0
	label	"地图配色修改:"
	poll    0

script
	value 	sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/copy_mapcfg.sh"
	label 	"写自定义导航图形到主机"

script
	value 	sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/restore_mapcfg.sh"
	label 	"从备份恢复导航图形"

keyValue
    value   String sys 0x00000000 0
	label	""
	poll    0

keyValue
    value   String sys 0x00000000 0
	label	"其它:"
	poll    0

choice
	value  	per 0x01c500e6 63
	label 	"开启接近提醒"

slider
	value 	per 0x01c500e6 64
	label 	"接近范围"
	limits 	absolute 0 255

choice
	value  	per 0x01c500e6 166
	label 	"地图显示帧率"
