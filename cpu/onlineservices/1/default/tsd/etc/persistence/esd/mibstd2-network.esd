screen Network MIBSTD2_Toolbox

script
	value 	sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/activate_telnet.sh"
	label 	"开 telnet/ftp (重启失效)"

script
	value 	sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/activate_qconn.sh"
	label 	"开 qconn (重启失效)"

script
	value 	sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/activate_console.sh"
	label 	"开串口控制台 (重启失效)"

script
	value 	sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/deactivate_access.sh"
	label 	"关 telnet/ftp/qconn"

script
	value 	sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/activate_perm_access.sh"
	label 	"开永久 telnet 与控制台"

script
	value 	sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/deactivate_perm_access.sh"
	label 	"关永久 telnet 与控制台"

choice
	value 	per 0x01c100e7 54
	label 	"以太网:"
	poll 	500

keyValue
	value 	String per 0x01c100e7 76
	label 	"当前主机 IP:"
	poll 	100

script
	value 	sys 1 0x0100 "/tsd/etc/persistence/esd/scripts/test_internet.sh"
	label 	"测试联网"

keyValue
    value   String sys 0x00000000 0
	label 	""
	poll 	0

keyValue
    value   String sys 0x00000000 0
	label 	"--- 未测试 ---"
	poll 	0

choice
	value 	per 0x01b800e1 93
	label 	"D-Link 网卡模式"
	poll 	2000

choice
	value 	per 0x01b800e1 92
	label 	"允许任意 USB 上网卡"
	poll 	2000